erDiagram
    USERS ||--o| BORROWERS : "corresponds to"
    BORROWERS ||--o{ LOANS : "has"
    BOOKS ||--o{ LOANS : "appears in"
    BOOKS ||--o{ BOOK_AUTHORS : "has"
    AUTHORS ||--o{ BOOK_AUTHORS : "wrote"
    BOOKS ||--o{ BOOK_GENRES : "has"
    GENRES ||--o{ BOOK_GENRES : "categorizes"

    USERS {
        int id PK
        string email
        string name
        timestamp created_at
    }

    BORROWERS {
        int borrower_id PK
        int user_id FK
    }

    BOOKS {
        int book_id PK
        string title
        string isbn
        int publication_year
    }

    AUTHORS {
        int author_id PK
        string name
    }

    GENRES {
        int genre_id PK
        string name
    }

    BOOK_AUTHORS {
        int book_author_id PK
        int book_id FK
        int author_id FK
    }

    BOOK_GENRES {
        int book_genre_id PK
        int book_id FK
        int genre_id FK
    }

    LOANS {
        int loan_id PK
        int borrower_id FK
        int book_id FK
    }